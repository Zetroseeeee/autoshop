# ---- Basket environment -----------------------------------------------------
# Copy to .env.local for local dev. On Vercel, add each one under
# Project → Settings → Environment Variables. Never commit real values.

# Neon Postgres connection string (use the pooled "-pooler" host on Vercel). Prefer sslmode=verify-full —
# the app verifies the certificate either way, and node-postgres warns about plain sslmode=require.
DATABASE_URL=

# Vercel Blob read/write token (Storage → Blob → create store → token).
BLOB_READ_WRITE_TOKEN=

# Google AI Studio key — used for studio packshots and the brand/category text fallback.
# NOTE: the image models (Nano Banana) have NO free tier — enable billing on the key's Google Cloud
# project (AI Studio → your API key → "Set up billing") or studio photos fail with a quota error.
# The text fallback works on the free tier.
GEMINI_API_KEY=

# Secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it signs every account out of every device.
AUTH_SECRET=

# Optional — ScraperAPI (or compatible) key for bot-walled sites like Vinted/Depop/Grailed/eBay.
SCRAPER_API_KEY=

# Public URL of the deployment, no trailing slash. Used for absolute links (share target, Shortcut guide).
APP_URL=https://basket-emile.vercel.app

# "true" (recommended) generates a studio packshot automatically after every successful fetch,
# so you never have to press a button. Costs roughly $0.067 per image — see STUDIO_MONTHLY_CAP.
AUTO_STUDIO=true

# Maximum studio generations per calendar month (default 200).
STUDIO_MONTHLY_CAP=200

# "true" to also generate an AI-guessed back view for each studio shot (default false).
BACK_VIEW=false

# Optional, local dev only — path to a Chrome/Chromium binary for Tier 2 rendered fetches.
# On Vercel the bundled @sparticuz/chromium is used automatically; on macOS Chrome is auto-detected.
# CHROME_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# Optional — set on Vercel to protect the daily price-check cron (Vercel sends it as a Bearer token).
# CRON_SECRET=
